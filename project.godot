; Godot 3.6 project configuration file.
; Do not edit this file while the project is running.
config_version=4

[application]
config/name="Shinobi Arena 2D"
run/main_scene="res://scenes/main.tscn"

[autoload]
GameSession="*res://scripts/game_session.gd"

[display]
window/size/width=1280
window/size/height=720
window/size/test_width=1280
window/size/test_height=720
window/stretch/mode="2d"
window/stretch/aspect="keep"

[rendering]
quality/driver/driver_name="GLES2"
vram_compression/import_etc=true
vram_compression/import_etc.HTML5=false
quality/2d/use_pixel_snap=false
environment/default_clear_color=Color(0.035, 0.045, 0.08, 1)
